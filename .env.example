# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Payment bypass (server-only).
# SECURITY: Never use ?bypass= in URLs — use header: x-bypass-token: VALUE
BYPASS_SECRET=
# Comma-separated admin emails (dashboard + onboard admin actions)
ADMIN_EMAILS=
# Server-only bypass user ID for pipeline internal calls (optional; requireAuth fallback)
BYPASS_USER_ID=

# Ziina (payments)
# Server-side token — obtain from https://business.ziina.com → Settings → Developers → API Keys
#
# Individual / API-only plan (no merchant webhooks):
#   - Set only ZIINA_API_TOKEN. Do NOT register a webhook URL in Ziina.
#   - Checkout success/failure still hits GET /api/ziina/verify (redirect URLs on each intent).
#   - Users who close the tab before redirect may need to re-open the app or run payment
#     recovery from the dashboard (no server push without a Business webhook).
#
# Business plan (optional webhooks):
#   - Set ZIINA_WEBHOOK_SECRET and register POST https://<your-domain>/api/ziina/webhook
#   - HMAC on raw JSON body, header X-Hmac-Signature
ZIINA_API_TOKEN=your_ziina_api_token
ZIINA_WEBHOOK_SECRET=
# Set true to reject webhook requests not from Ziina published IPs (can break tunnels)
ZIINA_WEBHOOK_ENFORCE_IP=false
# Set to false to disable post-7-day upgrade upsell redirect and /upsell
UPSELL_ENABLED=true

# Inngest (background DAG for report generation)
# Create workspace at https://www.inngest.com → Manage → Event Keys / Signing Keys
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key
# If true, report start never falls back to inline when Inngest is unavailable; returns 503 + INNGEST_DISPATCH_FAILED
REPORT_START_REQUIRE_INNGEST=
# Emergency override: set to 1 to allow inline (non-Inngest) pipeline on production (not recommended)
REPORT_PIPELINE_INLINE=

# Internal job auth (server-only): signs x-job-token for Inngest → API calls.
# Must be long, random, and not NEXT_PUBLIC_. If omitted, the app falls back to
# SUPABASE_SERVICE_ROLE_KEY for compatibility, but a dedicated secret is preferred.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JOB_TOKEN_SECRET=

# Upstash Redis (server-only): global rate limits, report-start locks, and shared caches.
# REQUIRED IN PRODUCTION: rate limiting is completely disabled without this
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# LLM — primary provider
ANTHROPIC_API_KEY=your_anthropic_api_key

# LLM — fallback chain (OpenAI → Grok → DeepSeek after Anthropic failures)
OPENAI_API_KEY=your_openai_api_key
# Grok (xAI) — optional fallback provider
GROK_API_KEY=
LLM_FALLBACK_GROK_MODEL=grok-4
LLM_FALLBACK_GROK_MODELS=grok-4.20,grok-4,grok-3
# Gemini — fallback and model_override gemini-*
GEMINI_API_KEY=
# DeepSeek — optional final fallback
DEEPSEEK_API_KEY=

# LLM fallback model overrides
LLM_FALLBACK_OPENAI_MODEL=gpt-5.5
LLM_FALLBACK_GEMINI_MODEL=gemini-2.0-flash
LLM_FALLBACK_DEEPSEEK_MODEL=deepseek-chat

# Commentary route model overrides (override the default claude-sonnet-4-6 / claude-haiku-4-5)
# REPORT_MONTHLY_MODEL=claude-sonnet-4-6
# REPORT_HOURLY_BATCH_MODEL=claude-haiku-4-5-20251001

# Ephemeris service (Railway URL after deploy; defaults to http://localhost:8000 for local dev)
EPHEMERIS_SERVICE_URL=https://your-service.up.railway.app
# Alias used by some older scripts (same value as EPHEMERIS_SERVICE_URL)
# EPHEMERIS_API_URL=

# Validation
# SERVER-ONLY: set to true to skip report content validation during pipeline (dangerous — use for debugging only)
SKIP_REPORT_VALIDATION=false
# CLIENT: DEPRECATED — do not use. Server-side SKIP_REPORT_VALIDATION replaces this.
# Setting to true bundles the flag into the client JS and is a security anti-pattern.
NEXT_PUBLIC_SKIP_VALIDATION=false

# App
NEXT_PUBLIC_URL=http://localhost:3000
# Canonical public URL used for internal pipeline dispatch (auto-detected from NEXT_PUBLIC_URL if unset)
# NEXT_PUBLIC_APP_URL=
# PUBLIC_APP_URL=

# RAG (pgvector Vedic scripture retrieval)
# Mode: hybrid (default) | dense | off
JYOTISH_RAG_MODE=hybrid
# Disable RAG entirely (overrides JYOTISH_RAG_MODE)
# DISABLE_RAG=false
# Embedding model (must match the indexed dimension — see migrations 20260425_jyotish_scriptures_768dim)
JYOTISH_RAG_EMBED_MODEL=text-embedding-004
JYOTISH_RAG_EMBED_DIMS=768
# RAG retrieval timeout in ms (default 8000)
RAG_TOTAL_TIMEOUT_MS=8000

# Pipeline tuning (advanced)
# Wall-clock budget for a single pipeline invocation in ms (auto-detected from Vercel plan if unset)
# REPORT_PIPELINE_BUDGET_MS=
# Base URL for internal pipeline API calls (auto-detected if unset)
# REPORT_PIPELINE_BASE_URL=

# Optional: protect /api/cron/* with Authorization: Bearer <secret>
# REQUIRED: Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Stale "generating" sweep: fail rows with no `updated_at` heartbeat for this many minutes
# (Inngest cleanup + GET /api/cron/stale-reports). Default 120; min 30. Full pipelines can run 60m+.
STALE_ORPHAN_UPDATED_AT_MINUTES=120

# Analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Notifications (optional — report-ready emails and WhatsApp)
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com
FOUNDER_EMAIL=
# Twilio (WhatsApp notifications)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Trusted Web Activity (Play Store) — /.well-known/assetlinks.json (rewrite → API)
# 1) Deploy; open /manifest.webmanifest and /.well-known/assetlinks.json in a browser.
# 2) npx @bubblewrap/cli init --manifest https://YOUR_DOMAIN/manifest.webmanifest
# 3) bubblewrap build; upload app-release-bundle.aab to Play Console (internal testing first).
# 4) Play Console → App signing: copy SHA-256 certificate fingerprint; set env below; redeploy.
# Fingerprints: colon-separated hex (e.g. AB:CD:...), multiple comma- or space-separated.
ANDROID_TWA_PACKAGE_NAME=com.vedichour.app
ANDROID_TWA_SHA256_FINGERPRINTS=
