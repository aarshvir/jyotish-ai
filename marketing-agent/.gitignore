node_modules/
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/KILL
data/heartbeat.json
# Media binaries stay local. The ONE exception is the music bed's licence record: the audio is
# gitignored, so LICENSE.md is the only thing in the repo that says what the bed is, where it
# legally came from, and how to reproduce it.
media/*
!media/music/
media/music/*
!media/music/LICENSE.md
.env
*.log
tmp/

# Rendered video output — binaries stay local; the publish sheets are committed.
output/reels/**/*.mp4
output/reels/**/*.jpg
output/reels/**/*.png
output/reels/**/*.wav
output/reels/**/*.mp3
output/reels/**/work/

# Send-tracking state holds REAL customer email addresses — never commit it.
output/email/sent.json
output/email/sent-followup.json

# Harvested/derived run state — regenerated by `npm run loop:sense` and
# `npm run playbook:review`. sense.json is third-party public text, not our source.
state/
