# Copy to marketing-engine/.env. Never commit the real file.
# Parent ../.env.local is also read. Last file wins.

# --- First-party (aggregated categories only; never birth data, never verbatim questions) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Generation: subscription CLIs are preferred (claude on PATH). API keys are fallback. ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Optional paid TTS. Off until you set both. Pre-flight blocks spend without a male voice id. ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_ENABLED=0

# --- YouTube Data API (official). Uploads stay private until the project passes Google's audit. ---
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Instagram Graph API. Do not post until App Review + Business verification. ---
META_IG_ACCESS_TOKEN=
META_IG_USER_ID=

# --- Meta CAPI / GA4. No birth data, no personal_context, no names. ---
META_PIXEL_ID=
META_CAPI_TOKEN=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# --- Email (staged unless you explicitly enable send) ---
RESEND_API_KEY=
DIGEST_TO=

# --- Reddit: commercial use needs a written Reddit contract. Leave 0. ---
REDDIT_COMMERCIAL_LICENSE=0
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Blog promote into the Next.js app (0 = stage only) ---
AUTO_PUBLISH_BLOG=0

# --- Capture the live product, never localhost admin, never /pricing ---
CAPTURE_BASE_URL=https://www.vedichour.com
